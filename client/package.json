{
  "name": "nat-tunnel-client",
  "version": "1.0.0",
  "description": "NatTunnel 内网穿透客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "build:setup": "electron-builder --dir && \"%LOCALAPPDATA%/electron-builder/Cache/nsis/nsis-3.0.4.1/Bin/makensis.exe\" installer.nsi",
    "dev": "electron ."
  },
  "build": {
    "appId": "com.rainking.nat-tunnel",
    "productName": "NatTunnel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tunnel.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "sign": null,
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "NatTunnel.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
